FROM python:3.12-slim

WORKDIR /app

COPY requirements-api.txt .
RUN pip install --no-cache-dir -r requirements-api.txt

COPY script/api.py script/api.py
COPY models/xgboost.pkl models/xgboost.pkl
COPY models/rdforest.joblib models/rdforest.joblib
COPY models/etiquette_knn_model.pkl models/etiquette_knn_model.pkl
COPY models/etiquette_arbre_de_decision_model.pkl models/etiquette_arbre_de_decision_model.pkl

WORKDIR /app/script
CMD ["sh", "-c", "uvicorn api:app --host 0.0.0.0 --port ${PORT:-8000}"]